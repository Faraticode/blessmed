# Copy this file to .env and fill in your own values

# Option A: Local MongoDB (if you installed MongoDB Community Edition locally)
# MONGO_URI=mongodb://127.0.0.1:27017/blessmed

# Option B: MongoDB Atlas (cloud) - replace <username>, <password>, and the cluster address
# with your own from the Atlas dashboard (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blessmed?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Needed for AI-generated reminder suggestions. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port the backend server runs on
PORT=5000

# --- Google Health API (steps auto-sync from Fitbit / Pixel Watch / etc.) ---
# 1. Create a project at console.cloud.google.com, enable the "Google Health API"
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add GOOGLE_REDIRECT_URI below as an authorized redirect URI in that client
# Docs: https://developers.google.com/health/setup
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/callback/google

# Public URL of this app (used to build redirect + webhook links). Set this
# to your real domain in production, e.g. https://blessmed.app
APP_BASE_URL=http://localhost:5000
