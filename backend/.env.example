# Copy this file to .env and fill in your own values

# Option A: Local MongoDB (if you installed MongoDB Community Edition locally)
# MONGO_URI=mongodb://127.0.0.1:27017/blessmed

# Option B: MongoDB Atlas (cloud) - replace <username>, <password>, and the cluster address
# with your own from the Atlas dashboard (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blessmed?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server runs on
PORT=5000
